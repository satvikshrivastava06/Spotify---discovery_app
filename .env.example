# Copy this file to .env.local (already .gitignored) and fill in real
# values for local development, or set these as CI build secrets for
# release builds. Never commit an .env file containing real values.
#
# These are the shared, embedded Spotify app credentials from Phase 2/6 —
# NOT a per-user secret. See the Phase 6 Module 4 notes in the project
# spec for the threat model around shipping these embedded in a public
# binary (low sensitivity: public-catalog-read access only).

VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=
